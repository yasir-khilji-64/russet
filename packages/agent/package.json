{
  "name": "@russet/agent",
  "version": "0.1.0",
  "description": "Agent execution and lifecycle coordination for Russet.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "clean": "tsc --build tsconfig.build.json --clean",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test examples",
    "format": "oxfmt --check src test examples"
  },
  "dependencies": {
    "@russet/ai": "workspace:^"
  }
}
